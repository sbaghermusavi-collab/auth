<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="011-add-tenant-ui-and-auth-config-columns" author="seyyed">
        <addColumn tableName="tenants">
            <column name="title" type="varchar(255)"/>
            <column name="theme_tone" type="varchar(32)" defaultValue="dark"/>
            <column name="animation_type" type="varchar(32)" defaultValue="orbit"/>
            <column name="auth_bg" type="varchar(64)" defaultValue="#072b2f"/>
            <column name="otp_enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="password_enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="captcha_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="011-update-default-tenant-branding" author="seyyed">
        <update tableName="tenants">
            <column name="name" value="آسانک"/>
            <column name="title" value="سامانه آسانک — پنل ارتباط یکپارچه"/>
            <column name="theme_tone" value="dark"/>
            <column name="animation_type" value="orbit"/>
            <column name="primary_color" value="#0C747C"/>
            <column name="secondary_color" value="#FABD09"/>
            <column name="auth_bg" value="#072b2f"/>
            <column name="otp_enabled" valueBoolean="true"/>
            <column name="password_enabled" valueBoolean="true"/>
            <column name="captcha_enabled" valueBoolean="false"/>
            <where>code = 'default'</where>
        </update>
    </changeSet>

