<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    logicalFilePath="db/changelog/db.changelog-master.yaml"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="009-add-profile-completed-to-users" author="antigravity">
        <addColumn tableName="users">
            <column name="profile_completed" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="national_code" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(120)"/>
            <column name="full_name" type="VARCHAR(150)"/>
        </addColumn>
    </changeSet>

    <changeSet id="009-create-refresh-token-records" author="antigravity">
        <createTable tableName="refresh_token_records">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="token_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_number" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_revoked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="refresh_token_records" indexName="idx_refresh_family">
            <column name="family_id"/>
        </createIndex>
        <createIndex tableName="refresh_token_records" indexName="idx_refresh_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
